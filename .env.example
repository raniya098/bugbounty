SECRET_KEY=generate-a-unique-random-value-before-deploying
DATABASE_PATH=instance/eventhub.db
FLASK_ENV=development
SEED_DEMO_DATA=true
# For a fresh production database, set SEED_DEMO_DATA=false and provide both:
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=use-a-unique-password-of-at-least-10-characters
